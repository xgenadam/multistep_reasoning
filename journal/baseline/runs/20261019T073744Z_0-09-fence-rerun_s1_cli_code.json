              {
                "id": "wordcount-py",
                "kind": "file",
                "title": "wordcount.py",
                "body": "```python\n#!/usr/bin/env python3\n\"\"\"\nwordcount.py - A CLI tool to count lines, words, and characters in files.\n\nUsage:\n    python wordcount.py <file1> [<file2> ...]\n\"\"\"\n\nimport sys\nimport os\n\ndef count_file(filepath):\n    \"\"\"\n    Count lines, words, and characters in a file.\n    \n    Args:\n        filepath (str): Path to the file.\n        \n    Returns:\n        tuple: (lines, words, chars) or None if an error occurred reading the file.\n    \"\"\"\n    lines = 0\n    words = 0\n    chars = 0\n    \n    try:\n        with open(filepath, 'r', encoding='utf-8') as f:\n            for line in f:\n                lines += 1\n                words += len(line.split())\n                chars += len(line)\n    except Exception as e:\n        return None\n        \n    return lines, words, chars\n\ndef main():\n    # Get file paths from command line arguments\n    if len(sys.argv) < 2:\n        print(\"Usage: wordcount <file1> [<file2> ...]\", file=sys.stderr)\n        sys.exit(1)\n\n    file_paths = sys.argv[1:]\n    results = []\n    error_exit_code = 0\n\n    # Check if all files exist and count stats\n    for path in file_paths:\n        if not os.path.isfile(path):\n            print(f\"Error: File '{path}' does not exist.\", file=sys.stderr)\n            error_exit_code = 1\n            continue\n            \n        stats = count_file(path)\n        if stats is not None:\n            lines, words, chars = stats\n            results.append((path, lines, words, chars))\n        else:\n            print(f\"Error: Could not read '{path}'.\", file=sys.stderr)\n            error_exit_code = 1\n\n    # Print table for valid files\n    if results:\n        # Prepare table header and rows\n        headers = [\"File\", \"Lines\", \"Words\", \"Chars\"]\n        \n        # Calculate column widths\n        widths = [len(h) for h in headers]\n        rows = []\n        for path, lines, words, chars in results:\n            row = [path, str(lines), str(words), str(chars)]\n            for i, val in enumerate(row):\n                widths[i] = max(widths[i], len(val))\n            rows.append(row)\n            \n        # Print table\n        \n        # Header\n        header_line = \" | \".join(f\"{h:<{w}}\" for h, w in zip(headers, widths))\n        separator = \"-+-\".join(\"-\" * w for w in widths)\n        \n        print(header_line)\n        print(separator)\n        \n        for row in rows:\n            print(\" | \".join(f\"{v:<{w}}\" for v, w in zip(row, widths)))\n\n    # Exit with appropriate code\n    sys.exit(error_exit_code)\n\nif __name__ == \"__main__\":\n    main()\n```",
                "origin_task": "Write the wordcount.py script"
              },
