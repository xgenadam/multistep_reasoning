                "title": "wordcount.py",
                "body": "```python\nimport argparse\nimport os\nimport sys\n\ndef count_stats(filepath):\n    \"\"\"\n    Reads a file and returns (line_count, word_count, character_count).\n    Mimics standard `wc` behavior:\n    - Line count: number of newline characters.\n    - Word count: number of whitespace-separated sequences.\n    - Character count: total number of bytes (including newlines).\n    \"\"\"\n    with open(filepath, \"rb\") as f:\n        content = f.read()\n\n    lines = content.count(b\"\\n\")\n    words = len(content.split())\n    chars = len(content)\n\n    return lines, words, chars\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Count lines, words, and characters in files.\")\n    parser.add_argument(\n        \"files\",\n        nargs=\"+\",\n        help=\"One or more file paths to analyze\"\n    )\n    args = parser.parse_args()\n\n    # Validate that all provided paths exist\n    valid_files = []\n    for path in args.files:\n        if not os.path.exists(path):\n            print(f\"error: file '{path}' does not exist\", file=sys.stderr)\n            sys.exit(1)\n        valid_files.append(path)\n\n    # Prepare table header\n    # Calculate max width for the file path column to ensure alignment\n    max_filename_width = max(len(path) for path in valid_files) if valid_files else 0\n    # Set minimum widths for count columns\n    count_width = 10\n\n    header = f\"{'File':<{max_filename_width + 2}} {'Lines':>{count_width}} {'Words':>{count_width}} {'Chars':>{count_width}}\"\n    separator = \"-\" * len(header)\n\n    print(header)\n    print(separator)\n\n    for path in valid_files:\n        lines, words, chars = count_stats(path)\n        print(f\"{path:<{max_filename_width + 2}} {lines:>{count_width}} {words:>{count_width}} {chars:>{count_width}}\")\n\nif __name__ == \"__main__\":\n    main()\n```",
